#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# remove existing installation, if any
if [ -e "$HOME/bin/squash" ] || grep -qFx "# >>> squash-autocomplete >>>" "$HOME/.bashrc" 2>/dev/null; then
  echo "[squash INFO] Existing installation found, reinstalling"
fi
bash "$SCRIPT_DIR/uninstall" || exit 1


# check ~/bin/ exists. if not, create it
mkdir -p "$HOME/bin"


# copy squash executable to ~/bin/
cp "$SCRIPT_DIR/squash" "$HOME/bin/squash" || exit 1
chmod +x "$HOME/bin/squash"


# add autocomplete to .bashrc
cat <<'EOF' >> "$HOME/.bashrc"

# >>> squash-autocomplete >>>
_squash()
{
    local cur=${COMP_WORDS[COMP_CWORD]}
    COMPREPLY=( $(compgen -W "$(git for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)" -- "$cur") )
}
complete -F _squash squash
# <<< squash-autocomplete <<<
EOF

echo "[squash INFO] Installed in $HOME/bin/squash"
case ":$PATH:" in
  *":$HOME/bin:"*) ;;
  *) echo "[squash WARNING] $HOME/bin is not in PATH yet, restart the terminal or add it to PATH" ;;
esac
